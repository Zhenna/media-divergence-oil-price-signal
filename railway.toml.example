# Copy this file to railway.toml and fill in your values
# Never commit railway.toml — it contains secrets
# railway.toml is gitignored

[build]
builder = "RAILPACK"

[deploy]
# Pass API key inline — Railway Beta Runtime V2 blocks dashboard variable injection
startCommand = "OPENAI_API_KEY=your-openai-key-here uvicorn backend.main:app --host 0.0.0.0 --port $PORT"
healthcheckPath = "/api/topics"
healthcheckTimeout = 60
restartPolicyType = "on_failure"

[environment]
PRESSLENS_PROVIDER = "openai"
PRESSLENS_URL = "https://your-presslens-url.up.railway.app"
PIPELINE_CADENCE = "daily"
LANGCHAIN_TRACING_V2 = "true"
LANGCHAIN_PROJECT = "media-divergence-oil-price-signal"
# Add these too once Railway fixes variable injection:
# DATABASE_URL = "postgresql://..."
# LANGCHAIN_API_KEY = "ls__..."
# MLFLOW_TRACKING_URI = "https://dagshub.com/..."
# MLFLOW_TRACKING_USERNAME = "yourname"
# MLFLOW_TRACKING_PASSWORD = "your-token"
